# ── 通用 ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=InventoryOS
API_V1_PREFIX=/api/v1

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory_dev_password
POSTGRES_DB=inventory_os
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://inventory:inventory_dev_password@localhost:5432/inventory_os
TEST_DATABASE_URL=postgresql+asyncpg://inventory:inventory_dev_password@localhost:5432/inventory_os_test

# ── Auth ──────────────────────────────────────────────
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── 默认 Demo 组织/用户（seed 使用）───────────────────
DEMO_ORG_NAME=华东精密制造有限公司
DEMO_ORG_SLUG=huadong-precision
DEMO_ADMIN_EMAIL=admin@inventoryos.dev
DEMO_ADMIN_PASSWORD=Demo@12345

# ── AI Provider（留空则系统以非 AI 模式运行）─────────
AI_PROVIDER=demo
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Market Provider（无真实 Key 时使用 Mock）─────────
MARKET_PROVIDER=mock
MARKET_HTTP_URL=
MARKET_HTTP_TOKEN=
MARKET_RSS_URL=

# ── CORS ──────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
